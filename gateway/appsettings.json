{
  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "auth",
        "Order": 0,
        "Match": {
          "Path": "/auth/login",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "refresh": {
        "ClusterId": "auth",
        "Order": 0,
        "Match": {
          "Path": "/auth/refresh",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "admin": {
        "ClusterId": "auth",
        "Order": 0,
        "Match": {
          "Path": "/auth/admin/{**rest}"
        },
        "AuthorizationPolicy": "system-admin",
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "approve": {
        "ClusterId": "booking",
        "Order": 0,
        "Match": {
          "Path": "/booking/bookings/{id}/approve",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "manager",
        "Transforms": [
          {
            "PathRemovePrefix": "/booking"
          }
        ]
      },
      "reject": {
        "ClusterId": "booking",
        "Order": 0,
        "Match": {
          "Path": "/booking/bookings/{id}/reject",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "manager",
        "Transforms": [
          {
            "PathRemovePrefix": "/booking"
          }
        ]
      },
      "team": {
        "ClusterId": "booking",
        "Order": 0,
        "Match": {
          "Path": "/booking/team/{**rest}"
        },
        "AuthorizationPolicy": "manager",
        "Transforms": [
          {
            "PathRemovePrefix": "/booking"
          }
        ]
      },
      "dispatch": {
        "ClusterId": "booking",
        "Order": 0,
        "Match": {
          "Path": "/booking/dispatch/{**rest}"
        },
        "AuthorizationPolicy": "dispatcher",
        "Transforms": [
          {
            "PathRemovePrefix": "/booking"
          }
        ]
      },
      "auth": {
        "ClusterId": "auth",
        "Order": 10,
        "Match": {
          "Path": "/auth/{**rest}"
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "gis": {
        "ClusterId": "gis",
        "Order": 10,
        "Match": {
          "Path": "/gis/{**rest}"
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathRemovePrefix": "/gis"
          }
        ]
      },
      "booking": {
        "ClusterId": "booking",
        "Order": 10,
        "Match": {
          "Path": "/booking/{**rest}"
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathRemovePrefix": "/booking"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "primary": {
            "Address": "http://auth:8080/"
          }
        }
      },
      "gis": {
        "Destinations": {
          "primary": {
            "Address": "http://gis:8080/"
          }
        }
      },
      "booking": {
        "Destinations": {
          "primary": {
            "Address": "http://booking:8080/"
          }
        }
      }
    }
  }
}
