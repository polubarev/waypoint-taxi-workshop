FROM docker.io/library/node:22-bookworm-slim AS web
WORKDIR /src
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY scripts/vendor.mjs scripts/vendor.mjs
COPY web web
RUN node scripts/vendor.mjs
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish gateway/Gateway.csproj -c Release -o /out
FROM mcr.microsoft.com/dotnet/aspnet:8.0
ENV ASPNETCORE_URLS=http://+:8080
WORKDIR /app
COPY --from=build /out .
COPY --from=web /src/web ./wwwroot
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet","Gateway.dll"]
