FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG PROJECT
COPY . /src
WORKDIR /src
RUN dotnet publish "$PROJECT" -c Release -o /out
FROM mcr.microsoft.com/dotnet/aspnet:8.0
ARG DLL
ENV APP_DLL=$DLL
ENV ASPNETCORE_URLS=http://+:8080
WORKDIR /app
COPY --from=build /out .
USER app
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec dotnet \"$APP_DLL\""]
